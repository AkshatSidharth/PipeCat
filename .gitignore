# ── Secrets / local config ────────────────────────────────────────────────
# Never commit real keys. `.env.example` is the template that *is* tracked.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtualenvs (run.sh expects .venv)
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.ipynb_checkpoints/

# ── Runtime artefacts ─────────────────────────────────────────────────────
# Call recordings + per-call analysis (VOICEBOT_RECORDINGS_DIR / _ANALYSIS_DIR).
recordings/

# Structured logs (voicebot.jsonl and friends).
logs/
*.log
*.jsonl

# Generated backchannel TTS cache (voicebot/filler.py CACHE_DIR).
assets/backchannels/

# Loose audio dropped anywhere in the tree.
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.webm
*.raw
*.pcm

# ── Observability stack local state ───────────────────────────────────────
observability/data/
observability/**/data/
observability/grafana/grafana.db

# ── Editors / OS ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
