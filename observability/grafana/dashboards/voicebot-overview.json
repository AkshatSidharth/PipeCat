      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "voicebot-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(voicebot_ttfb_seconds_bucket[5m])) by (le, service_type))",
          "legendFormat": "{{service_type}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
