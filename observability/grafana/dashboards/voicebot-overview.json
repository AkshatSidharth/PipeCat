      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Processing time p95 by service",
      "description": "Full request duration, not just first byte.",
      "datasource": {
        "type": "prometheus",
        "uid": "voicebot-prometheus"
      },
