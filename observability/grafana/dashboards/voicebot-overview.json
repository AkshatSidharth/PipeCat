            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "TTS time-to-first-audio",
      "description": "TTFA is TTFB plus silence padded onto the front of the response. A large gap between the two is the vendor padding, not your network.",
      "datasource": {
        "type": "prometheus",
        "uid": "voicebot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "voicebot-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(voicebot_ttfa_seconds_bucket[5m])) by (le))",
          "legendFormat": "TTFA p95",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "voicebot-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(voicebot_tts_leading_silence_seconds_bucket[5m])) by (le))",
          "legendFormat": "leading silence p95",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
