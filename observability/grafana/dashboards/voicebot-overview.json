    {
      "id": 16,
      "type": "timeseries",
      "title": "LLM tokens / min by kind",
      "description": "prompt / completion / cache_read / cache_creation / reasoning. A healthy cached call is mostly cache_read.",
      "datasource": {
        "type": "prometheus",
        "uid": "voicebot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "voicebot-prometheus"
          },
          "expr": "sum(rate(voicebot_llm_tokens_total{kind!=\"total\"}[5m])) by (kind) * 60",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "min": 0,
